# A long random owner secret. Sync is disabled until this is set.
FORKFOLIO_SECRET=
FORKFOLIO_DATA_DIR=./data
# Set this to the trusted HTTPS origin behind your private reverse proxy.
ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000

# Node adapter limit; each photo API request is additionally bounded to 15 MB.
BODY_SIZE_LIMIT=16M
